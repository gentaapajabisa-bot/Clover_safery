# Salin ke .env untuk pengembangan lokal (vercel dev). JANGAN di-commit.
# Di produksi, isi lewat Vercel > Project Settings > Environment Variables.

# Connection string dari TiDB Cloud (Serverless Driver).
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/clover_safery?sslaccept=strict"

# Masa berlaku sesi login dalam hari (1–30, bawaan 7).
SESSION_TTL_DAYS="7"
